# ==============================================================================
# user-service — Environment Variables
# Copy to .env and fill in values.
# Variables marked ** MUST MATCH AUTH SERVICE ** share the same JWT/DB config.
# ==============================================================================

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3501

# ── Database ** MUST MATCH AUTH SERVICE ** ────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/yourdb

# ── Redis (optional — rate limiting) ─────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── JWT ** MUST MATCH AUTH SERVICE ** ─────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_at_least_32_characters_long_access
JWT_REFRESH_SECRET=change_me_at_least_32_characters_long_refresh
JWT_ID_SECRET=change_me_at_least_32_characters_long_id
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=your-app-issuer
JWT_AUDIENCE=your-app-audience

# ── Service-to-Service ────────────────────────────────────────────────────────
# API key this service uses when calling other services
SERVICE_API_KEY=user-service-secret-key

# Comma-separated list of API keys that other services may use to call this service
ALLOWED_SERVICE_API_KEYS=auth-service-key,order-service-key,email-service-key

# ── API Gateway trust (optional) ─────────────────────────────────────────────
TRUST_GATEWAY=false
GATEWAY_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Downstream Services ───────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3500
EMAIL_SERVICE_URL=http://localhost:3502
ORDER_SERVICE_URL=http://localhost:3503
CART_SERVICE_URL=http://localhost:3504
WISHLIST_SERVICE_URL=http://localhost:3505
NOTIFICATION_SERVICE_URL=http://localhost:3506

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_FILE_SIZE=5242880

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BULK_RATE_LIMIT_MAX=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=pretty
# ── Tenant configuration ──────────────────────────────────────────────────────────────
# true  → x-tenant-id header required (falls back to DEFAULT_TENANT_ID when set).
# false → tenant is optional; service operates without multi-tenant isolation.
TENANCY_ENABLED=true
# Fallback tenant when x-tenant-id header is absent. Leave blank to require the header explicitly.
DEFAULT_TENANT_ID=your-tenant-slug
