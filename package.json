{
  "name": "user-service",
  "version": "1.0.0",
  "description": "User microservice — CRUD, profile, preferences, and lifecycle management",
  "main": "server.js",
  "scripts": {
    "start":          "node server.js",
    "start:prod":     "NODE_ENV=production node server.js",
    "dev":            "nodemon server.js",
    "lint":           "eslint src/",
    "lint:fix":       "eslint src/ --fix",
    "test":           "jest --runInBand --forceExit",
    "test:watch":     "jest --watch",
    "test:coverage":  "jest --runInBand --forceExit --coverage",
    "test:ci":        "jest --runInBand --forceExit --coverage --ci --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^1.0.40",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
